{
  "name": "diaspomoney",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "start": "next start",
    "build:css": "tailwindcss -i ./styles/globals.css -o ./public/styles.css --minify",
    "build": "next build --webpack && pnpm build:css",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:next": "next lint || echo 'Warning: next lint has a known issue with pnpm. Use pnpm lint instead.'",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "playwright test --reporter=html",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "tsc:check": "tsc --noEmit",
    "tsc:check:strict": "tsc --noEmit --strict",
    "tsc:check:fix": "tsc --noEmit --strict --fix",
    "tsc:check:silent": "tsc --noEmit --strict --silent",
    "deploy:dev": "./scripts/deploy-full.sh dev",
    "deploy:rct": "./scripts/deploy-full.sh rct",
    "deploy:prod": "./scripts/deploy-full.sh prod",
    "logs:watch": "bash ./scripts/watch-logs.sh",
    "logs:watch:win": "powershell -ExecutionPolicy Bypass -File ./scripts/watch-logs.ps1",
    "logs:errors": "bash ./scripts/watch-logs-errors.sh",
    "logs:errors:win": "powershell -ExecutionPolicy Bypass -File ./scripts/watch-logs-errors.ps1",
    "dev:filtered": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(info|warning|error|api)'\"",
    "dev:filtered:errors": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(error|warning|fatal)'\"",
    "check:stripe": "echo 'Ouvrez http://localhost:3000/api/stripe/check-config dans votre navigateur'",
    "check:stripe:logs": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(stripe|Stripe|STRIPE|payment|Payment|PAYMENT)'\"",
    "cleanup:images": "node scripts/find-unused-images.js --dry-run",
    "cleanup:images:delete": "node scripts/find-unused-images.js --delete",
    "cleanup:docker": "./scripts/cleanup-docker.sh --dry-run",
    "cleanup:docker:all": "./scripts/cleanup-docker.sh --all"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/mongodb-adapter": "^1",
    "@sentry/nextjs": "^10.25.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.4.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/pdfkit": "^0.17.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.553.0",
    "mongodb": "^7.0.0",
    "mongoose": "^8.19.3",
    "next": "16.1.1",
    "next-auth": "4.24.13",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.66.0",
    "react-international-phone": "^4.6.1",
    "recharts": "^3.5.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^2.0.0",
    "speakeasy": "^2.0.0",
    "stripe": "^19.3.1",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.56.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^4.0.13"
  },
  "pnpm": {
    "overrides": {
      "import-in-the-middle": "1.15.0",
      "require-in-the-middle": "8.0.1"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "cypress",
      "sharp",
      "unrs-resolver"
    ]
  },
  "ignore-workspace-root-check": true,
  "packageManager": "pnpm@10.18.3"
}
