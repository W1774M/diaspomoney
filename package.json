{
  "name": "diaspomoney",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "start": "next start",
    "build:css": "tailwindcss -i ./styles/globals.css -o ./public/styles.css --minify",
    "build": "next build --webpack && pnpm build:css",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:next": "next lint || echo 'Warning: next lint has a known issue with pnpm. Use pnpm lint instead.'",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:ci": "playwright test --reporter=html",
    "test:unit:client": "vitest run --config vitest.config.ts",
    "test:unit:server": "vitest run --config vitest.server.config.ts",
    "test:unit": "pnpm -s test:unit:client && pnpm -s test:unit:server",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:reset": "pnpm -s test:db:down && pnpm -s test:db:up",
    "tsc:check": "tsc --noEmit",
    "tsc:check:strict": "tsc --noEmit --strict",
    "tsc:check:fix": "tsc --noEmit --strict --fix",
    "tsc:check:silent": "tsc --noEmit --strict --silent",
    "deploy:dev": "./scripts/deploy-compose.sh dev",
    "deploy:rct": "./scripts/deploy-compose.sh rct",
    "deploy:prod": "./scripts/deploy-compose.sh prod",
    "deploy:all": "./scripts/deploy-compose.sh all",
    "infra:up": "docker compose -f ../compose.infra.yml --env-file .env up -d",
    "infra:down": "docker compose -f ../compose.infra.yml --env-file .env down",
    "compose:config": "docker compose config",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "dev:filtered": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(info|warning|error|api)'\"",
    "dev:filtered:errors": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(error|warning|fatal)'\"",
    "check:stripe": "echo 'Ouvrez http://localhost:3000/api/stripe/check-config dans votre navigateur'",
    "check:stripe:logs": "powershell -Command \"$env:LOG_FILE='true'; pnpm dev | Select-String -Pattern '(stripe|Stripe|STRIPE|payment|Payment|PAYMENT)'\"",
    "cleanup:images": "node scripts/find-unused-images.js --dry-run",
    "cleanup:images:delete": "node scripts/find-unused-images.js --delete",
    "cleanup:docker": "./scripts/cleanup-docker.sh --dry-run",
    "cleanup:docker:all": "./scripts/cleanup-docker.sh --all"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@sentry/nextjs": "^11.18.0",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/pdfkit": "^0.17.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coss": "^0.13.1",
    "country-flag-icons": "^1.6.20",
    "framer-motion": "^14.14.0",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^4.2.2",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.80.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-international-phone": "^4.8.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.1",
    "remark-breaks": "^4.0.0",
    "require-in-the-middle": "8.0.1",
    "resend": "^6.40.0",
    "speakeasy": "^2.0.0",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "pnpm": {
    "overrides": {
      "import-in-the-middle": "1.15.0",
      "require-in-the-middle": "8.0.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "cypress",
      "sharp",
      "unrs-resolver"
    ]
  },
  "ignore-workspace-root-check": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.18.3"
}
